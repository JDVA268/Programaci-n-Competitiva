#include <iostream>
using namespace std;

int main() {
    int dias, anos, meses, resto;

    cin >> dias;

    anos = dias / 365;
    resto = dias % 365;

    meses = resto / 30;
    dias = resto % 30;

    cout << anos << " ano(s)" << endl;
    cout << meses << " mes(es)" << endl;
    cout << dias << " dia(s)" << endl;

    return 0;
}
